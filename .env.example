# Copy to .env.local for local dev (never commit secrets).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional but recommended for invite → password login.
# Dashboard → Project Settings → API → service_role (secret).
# Enables email confirmation when users finish /set-password.
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 to show one-click demo sign-in per role on /login (needs the service role key).
# Leave unset in production once roles are signed off.
NEXT_PUBLIC_DEMO_LOGINS=
